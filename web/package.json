{
  "name": "fantasy-quant-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dashboard for fantasy_quant. A thin client over the analytics CLI's JSON payloads -- it computes nothing.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:checked": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.8"
  }
}
