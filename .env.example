# ESPN private-league auth.
# DevTools -> Application -> Cookies -> espn.com. Keep the braces on SWID.
# espn_s2 lasts ~a year and dies silently, usually mid-season. The ops canary watches for that.
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=

# Optional paid sources. Everything in Phase 0 works without any of these.
FANTASYPROS_API_KEY=
BALLDONTLIE_API_KEY=
ODDS_API_KEY=
